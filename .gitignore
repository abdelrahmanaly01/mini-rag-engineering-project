# =============================================================================
# Universal .gitignore
# Trim sections you don't need; keep the secrets and OS sections always.
# Lockfiles (package-lock.json, yarn.lock, poetry.lock, Cargo.lock for apps,
# etc.) are intentionally NOT ignored: commit them.
# =============================================================================


# -----------------------------------------------------------------------------
# Secrets & credentials (never commit these)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
secrets.*
*.secret
*.secrets
credentials.json
service-account*.json
.aws/
.npmrc
.pypirc
.netrc
.htpasswd
terraform.tfvars
*.auto.tfvars


# -----------------------------------------------------------------------------
# Operating system files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems
Icon?

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Linux
*~
.directory
.fuse_hidden*
.Trash-*
.nfs*


